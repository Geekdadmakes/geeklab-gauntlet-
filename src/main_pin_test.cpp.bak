/**
 * PIN CONNECTIVITY TEST
 * Toggles all display pins to verify wiring
 * Use a multimeter or LED to check each pin
 */

#include <Arduino.h>

// Display pins
#define TFT_CS   15
#define TFT_DC   2
#define TFT_RST  4
#define TFT_MOSI 11
#define TFT_SCLK 18
#define TFT_MISO 19
#define TFT_BL   21

void setup() {
    Serial.begin(115200);
    delay(1000);

    Serial.println("\n\n=== PIN CONNECTIVITY TEST ===");
    Serial.println("Watch each pin with multimeter or LED");
    Serial.println("Each pin will toggle HIGH/LOW every second\n");

    // Set all pins as outputs
    pinMode(TFT_CS, OUTPUT);
    pinMode(TFT_DC, OUTPUT);
    pinMode(TFT_RST, OUTPUT);
    pinMode(TFT_MOSI, OUTPUT);
    pinMode(TFT_SCLK, OUTPUT);
    pinMode(TFT_BL, OUTPUT);
    pinMode(TFT_MISO, INPUT);

    Serial.println("Starting pin test...\n");
}

void loop() {
    static unsigned long lastToggle = 0;
    static bool state = false;
    static int currentPin = 0;

    if (millis() - lastToggle > 1000) {
        state = !state;

        switch(currentPin) {
            case 0:
                digitalWrite(TFT_CS, state);
                Serial.print("CS (GPIO 15): ");
                Serial.println(state ? "HIGH" : "LOW");
                break;
            case 1:
                digitalWrite(TFT_DC, state);
                Serial.print("DC (GPIO 2): ");
                Serial.println(state ? "HIGH" : "LOW");
                break;
            case 2:
                digitalWrite(TFT_RST, state);
                Serial.print("RST (GPIO 4): ");
                Serial.println(state ? "HIGH" : "LOW");
                break;
            case 3:
                digitalWrite(TFT_MOSI, state);
                Serial.print("MOSI (GPIO 11): ");
                Serial.println(state ? "HIGH" : "LOW");
                break;
            case 4:
                digitalWrite(TFT_SCLK, state);
                Serial.print("SCLK (GPIO 18): ");
                Serial.println(state ? "HIGH" : "LOW");
                break;
            case 5:
                digitalWrite(TFT_BL, state);
                Serial.print("BACKLIGHT (GPIO 21): ");
                Serial.println(state ? "HIGH" : "LOW");
                Serial.println("--- You should see backlight toggle! ---\n");
                currentPin = -1;  // Reset to start over
                break;
        }

        currentPin++;
        lastToggle = millis();
    }
}
